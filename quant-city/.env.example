# Copy to .env locally. Do not commit real credentials.
HOST=127.0.0.1
PORT=8080
ENABLE_PAID_AI=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
SESSION_SECRET=
APP_USER=player
APP_PASSWORD=
# Separate image provider is intentionally unconfigured.
IMAGE_PROVIDER=mock

# Optional paid character voices. Configure only after approving ElevenLabs usage.
ENABLE_ELEVENLABS=false
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_AI=
ELEVENLABS_VOICE_RISK=
ELEVENLABS_VOICE_TECH=
ELEVENLABS_VOICE_FINANCE=
